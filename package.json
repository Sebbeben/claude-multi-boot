{
  "name": "claude-swarm",
  "version": "0.1.0",
  "description": "Sync Claude Code sessions across multiple machines in real-time",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-swarm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:server": "node dist/server/index.js",
    "start:client": "node dist/cli.js"
  },
  "keywords": ["claude", "claude-code", "sync", "multi-machine", "development"],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  }
}
