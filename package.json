{
  "name": "claude-swarm",
  "version": "0.3.0",
  "description": "Sync Claude Code sessions across multiple machines in real-time",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-swarm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "node dist/server/index.js",
    "start:client": "node dist/cli.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "sync",
    "multi-machine",
    "development"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
